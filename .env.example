# Google Gemini API Key (Server-side secret, do not expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: a separate key per AI feature. Gemini quotas are per Google Cloud
# project, so create each key in its own project to give each feature its own
# limit. Any feature without its own key (or whose key runs out) uses
# GEMINI_API_KEY above.
GEMINI_API_KEY_ASSESSMENT=
GEMINI_API_KEY_INTERVIEW=
GEMINI_API_KEY_RESUME=
GEMINI_API_KEY_REVIEW=

# Supabase Server & Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_PROJECT_ID=your_supabase_project_id

# Client-safe Supabase Configuration (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id


